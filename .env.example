# ============================================================
# Copia este archivo como .env y cambia todos los secretos.
# El archivo .env NO debe subirse al repositorio.
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_DB=ecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esta-clave-postgres
POSTGRES_PORT=5432
JPA_DDL_AUTO=update

# ---------- RabbitMQ ----------
# No uses "guest": RabbitMQ solo permite ese usuario desde localhost.
RABBITMQ_USER=ecommerce
RABBITMQ_PASSWORD=cambia-esta-clave-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ---------- JWT ----------
# Minimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-jwt-de-al-menos-32-caracteres-0001
JWT_EXPIRATION_MINUTES=1440

# ---------- Puertos del host ----------
FRONTEND_PORT=3000
AUTH_PORT=9090
CATALOGO_PORT=9092
NOTIFICACIONES_PORT=9093
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---------- CORS ----------
# Debe coincidir con la URL desde la que el navegador abre el frontend.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------- Email (Mailpit en desarrollo) ----------
MAIL_FROM=no-reply@ecommerce.local
MAIL_FROM_NAME=E-Commerce

# ---------- SMS ----------
# log     -> escribe el SMS en el log (desarrollo)
# webhook -> lo envia a un gateway HTTP (Jasmin, Kannel, etc.)
SMS_PROVIDER=log
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# ---------- Frontend ----------
# Estas URLs se compilan dentro del bundle de React.
REACT_APP_AUTH_URL=http://localhost:9090
REACT_APP_CATALOGO_URL=http://localhost:9092
REACT_APP_REQUEST_TIMEOUT_MS=15000
