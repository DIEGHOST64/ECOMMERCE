{
  "info": {
    "name": "E-Commerce API",
    "description": "Coleccion de endpoints de la plataforma E-Commerce. El login guarda automaticamente el token JWT y el id del usuario. No se usa X-User-Role ni usuarioId en el carrito.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "auth_url",
      "value": "http://localhost:9090",
      "type": "string"
    },
    {
      "key": "catalogo_url",
      "value": "http://localhost:9092",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "usuarioId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "productoId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "compraId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registrar usuario",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana Perez\",\n  \"email\": \"ana@ejemplo.com\",\n  \"password\": \"secreto123\",\n  \"telefono\": \"+573001234567\",\n  \"edad\": 28\n}"
            },
            "url": {
              "raw": "{{auth_url}}/api/ecommerce/usuario/save",
              "host": [
                "{{auth_url}}"
              ],
              "path": [
                "api",
                "ecommerce",
                "usuario",
                "save"
              ]
            },
            "description": "Crea un usuario con rol USER. El rol no se puede elegir desde el cliente."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('token', data.token);",
                  "  pm.collectionVariables.set('usuarioId', data.id);",
                  "  pm.test('Token recibido', function () {",
                  "    pm.expect(data.token).to.be.a('string').and.not.empty;",
                  "  });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana@ejemplo.com\",\n  \"password\": \"secreto123\"\n}"
            },
            "url": {
              "raw": "{{auth_url}}/api/ecommerce/usuario/login",
              "host": [
                "{{auth_url}}"
              ],
              "path": [
                "api",
                "ecommerce",
                "usuario",
                "login"
              ]
            },
            "description": "Devuelve el JWT y guarda token + usuarioId en las variables de la coleccion."
          }
        },
        {
          "name": "Obtener usuario",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{auth_url}}/api/ecommerce/usuario/{{usuarioId}}",
              "host": [
                "{{auth_url}}"
              ],
              "path": [
                "api",
                "ecommerce",
                "usuario",
                "{{usuarioId}}"
              ]
            },
            "description": "Permitido para el propio usuario o un ADMIN."
          }
        },
        {
          "name": "Verificar existencia",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{auth_url}}/api/ecommerce/usuario/{{usuarioId}}/existe",
              "host": [
                "{{auth_url}}"
              ],
              "path": [
                "api",
                "ecommerce",
                "usuario",
                "{{usuarioId}}",
                "existe"
              ]
            },
            "description": "Endpoint interno publico. Devuelve true o false sin exponer datos personales."
          }
        },
        {
          "name": "Actualizar usuario",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{usuarioId}},\n  \"nombre\": \"Ana Perez Actualizada\",\n  \"email\": \"ana@ejemplo.com\",\n  \"telefono\": \"+573009876543\",\n  \"edad\": 29\n}"
            },
            "url": {
              "raw": "{{auth_url}}/api/ecommerce/usuario/update",
              "host": [
                "{{auth_url}}"
              ],
              "path": [
                "api",
                "ecommerce",
                "usuario",
                "update"
              ]
            },
            "description": "Actualiza el perfil propio o el de cualquier usuario si el token es ADMIN. El rol no se puede cambiar."
          }
        },
        {
          "name": "Eliminar usuario (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{auth_url}}/api/ecommerce/usuario/{{usuarioId}}",
              "host": [
                "{{auth_url}}"
              ],
              "path": [
                "api",
                "ecommerce",
                "usuario",
                "{{usuarioId}}"
              ]
            },
            "description": "Requiere rol ADMIN. Devuelve 204."
          }
        }
      ]
    },
    {
      "name": "Productos",
      "item": [
        {
          "name": "Listar productos",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{catalogo_url}}/api/ecommerce/producto",
              "host": [
                "{{catalogo_url}}"
              ],
              "path": [
                "api",
                "ecommerce",
                "producto"
              ]
            },
            "description": "Endpoint publico."
          }
        },
        {
          "name": "Obtener producto",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{catalogo_url}}/api/ecommerce/producto/{{productoId}}",
              "host": [
                "{{catalogo_url}}"
              ],
              "path": [
                "api",
                "ecommerce",
                "producto",
                "{{productoId}}"
              ]
            },
            "description": "Endpoint publico."
          }
        },
        {
          "name": "Crear producto (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Laptop Dell XPS 15\",\n  \"descripcion\": \"Laptop de alto rendimiento\",\n  \"precio\": 1299.99,\n  \"stock\": 10,\n  \"imagenUrl\": \"https://ejemplo.com/laptop.jpg\"\n}"
            },
            "url": {
              "raw": "{{catalogo_url}}/api/ecommerce/producto",
              "host": [
                "{{catalogo_url}}"
              ],
              "path": [
                "api",
                "ecommerce",
                "producto"
              ]
            },
            "description": "Requiere rol ADMIN. Devuelve 201."
          }
        },
        {
          "name": "Actualizar producto (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Laptop Dell XPS 15\",\n  \"descripcion\": \"Laptop actualizada\",\n  \"precio\": 1199.99,\n  \"stock\": 15,\n  \"imagenUrl\": \"https://ejemplo.com/laptop-nueva.jpg\"\n}"
            },
            "url": {
              "raw": "{{catalogo_url}}/api/ecommerce/producto/{{productoId}}",
              "host": [
                "{{catalogo_url}}"
              ],
              "path": [
                "api",
                "ecommerce",
                "producto",
                "{{productoId}}"
              ]
            },
            "description": "Requiere rol ADMIN."
          }
        },
        {
          "name": "Eliminar producto (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{catalogo_url}}/api/ecommerce/producto/{{productoId}}",
              "host": [
                "{{catalogo_url}}"
              ],
              "path": [
                "api",
                "ecommerce",
                "producto",
                "{{productoId}}"
              ]
            },
            "description": "Requiere rol ADMIN. Devuelve 204."
          }
        }
      ]
    },
    {
      "name": "Carrito",
      "item": [
        {
          "name": "Ver carrito",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{catalogo_url}}/api/ecommerce/carrito",
              "host": [
                "{{catalogo_url}}"
              ],
              "path": [
                "api",
                "ecommerce",
                "carrito"
              ]
            },
            "description": "El usuario se obtiene del JWT."
          }
        },
        {
          "name": "Agregar producto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productoId\": {{productoId}},\n  \"cantidad\": 2\n}"
            },
            "url": {
              "raw": "{{catalogo_url}}/api/ecommerce/carrito/agregar",
              "host": [
                "{{catalogo_url}}"
              ],
              "path": [
                "api",
                "ecommerce",
                "carrito",
                "agregar"
              ]
            },
            "description": "Cantidad entre 1 y 10. No reserva stock."
          }
        },
        {
          "name": "Actualizar cantidad",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{catalogo_url}}/api/ecommerce/carrito/actualizar/{{productoId}}?cantidad=3",
              "host": [
                "{{catalogo_url}}"
              ],
              "path": [
                "api",
                "ecommerce",
                "carrito",
                "actualizar",
                "{{productoId}}"
              ],
              "query": [
                {
                  "key": "cantidad",
                  "value": "3"
                }
              ]
            },
            "description": "La cantidad va como query param."
          }
        },
        {
          "name": "Eliminar producto",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{catalogo_url}}/api/ecommerce/carrito/eliminar/{{productoId}}",
              "host": [
                "{{catalogo_url}}"
              ],
              "path": [
                "api",
                "ecommerce",
                "carrito",
                "eliminar",
                "{{productoId}}"
              ]
            },
            "description": "Devuelve el carrito actualizado."
          }
        },
        {
          "name": "Vaciar carrito",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{catalogo_url}}/api/ecommerce/carrito/vaciar",
              "host": [
                "{{catalogo_url}}"
              ],
              "path": [
                "api",
                "ecommerce",
                "carrito",
                "vaciar"
              ]
            },
            "description": "Devuelve 204."
          }
        }
      ]
    },
    {
      "name": "Compras",
      "item": [
