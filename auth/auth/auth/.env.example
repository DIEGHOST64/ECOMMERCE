# Base de datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/ecommerce
DB_USERNAME=postgres
DB_PASSWORD=cambia-esta-clave
JPA_DDL_AUTO=update

# Servidor
SERVER_PORT=9090

# JWT (minimo 32 caracteres)
JWT_SECRET=cambia-este-secreto-jwt-de-al-menos-32-caracteres-0001
JWT_EXPIRATION_MINUTES=1440

# RabbitMQ (reemplazo de AWS SQS)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=ecommerce
RABBITMQ_PASSWORD=cambia-esta-clave-rabbitmq
NOTIFICACIONES_EXCHANGE=notificaciones.exchange

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
