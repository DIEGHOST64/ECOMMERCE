# Servidor
SERVER_PORT=9093

# RabbitMQ (reemplazo de AWS SQS)
# No uses "guest" si RabbitMQ corre en otro contenedor o en otra maquina.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=ecommerce
RABBITMQ_PASSWORD=cambia-esta-clave-rabbitmq
NOTIFICACIONES_EXCHANGE=notificaciones.exchange
NOTIFICACIONES_QUEUE=notificaciones.queue
NOTIFICACIONES_DLX=notificaciones.dlx
NOTIFICACIONES_DLQ=notificaciones.dlq

# Email por SMTP (Mailpit en desarrollo)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@ecommerce.local
MAIL_FROM_NAME=E-Commerce

# SMS: log o webhook
SMS_PROVIDER=log
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_WEBHOOK_CONNECT_TIMEOUT_MS=3000
SMS_WEBHOOK_READ_TIMEOUT_MS=5000
